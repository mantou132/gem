<% const route = (data, indent) => include('./route', data).trimEnd().replaceAll('\n', `\n${indent}`) -%>
// Generated by gemkit, do not edit

import { html } from '@mantou/gem';
import { errorRoute, layoutRoute, pageRoute, setOutlets } from '@mantou/gemkit';
<% if (it.rootLayout) { -%>
import * as RootLayout from <%= it.rootLayout %>;
<% } -%>

<% if (it.error) { -%>
const error = <%= route(it.error, '') %>;

<% } -%>
setOutlets({
<% for (const { tag, routes, error } of it.outlets) { -%>
  '<%= tag %>': [
<% for (const data of routes) { -%>
    <%= route(data, '    ') %>,
<% } -%>
<% if (error) { -%>
    error,
<% } -%>
  ],
<% } -%>
}<%= it.error ? ', error' : '' %>);

export const app = html`<gemkit-outlet></gemkit-outlet>`;
