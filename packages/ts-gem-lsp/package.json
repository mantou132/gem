{
  "name": "ts-gem-lsp",
  "version": "0.0.1",
  "description": "TypeScript 7 language server proxy for Gem",
  "keywords": [
    "gem",
    "typescript",
    "language-server"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/bin.js",
  "files": [
    "/dist/"
  ],
  "scripts": {
    "build": "esbuild ./src/index.ts ./src/bin.ts --outdir=./dist --platform=node --format=esm --sourcemap --bundle --packages=external",
    "start": "pnpm run build --watch",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "typescript": "7.1.0-dev.20261007.1",
    "vscode-jsonrpc": "^8.2.1"
  },
  "devDependencies": {
    "@gemjs/config": "^2.1.3"
  },
  "author": "mantou132",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantou132/gem.git",
    "directory": "packages/ts-gem-lsp"
  }
}
