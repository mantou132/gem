{
  "name": "gem-book",
  "version": "2.3.1",
  "description": "Build documentation websites from Markdown, with SSR/SSG powered by gemkit",
  "type": "module",
  "keywords": [
    "doc",
    "docs",
    "documentation",
    "creator",
    "generator"
  ],
  "bin": {
    "gem-book": "bin/index.mjs"
  },
  "exports": {
    "./plugin": "./app/plugin.ts",
    "./plugin/server": "./app/plugin.server.ts",
    "./elements/*": "./app/elements/*.ts",
    "./package.json": "./package.json",
    "./schema.json": "./schema.json"
  },
  "files": [
    "/app/",
    "/bin/",
    "/themes/",
    "schema.json"
  ],
  "scripts": {
    "build": "esbuild ./cli/index.ts --bundle --platform=node --format=esm --packages=external --outfile=./bin/index.mjs",
    "schema": "npx ts-json-schema-generator@1.5 -p cli/config.ts -t GemBookConfig -o schema.json",
    "docs": "node ./cli/index.ts docs",
    "prepublishOnly": "pnpm build",
    "build:website": "node ./cli/index.ts build docs"
  },
  "dependencies": {
    "@mantou/gem": "^2.3.1",
    "@mantou/gemkit": "^0.2.0",
    "@rsbuild/core": "^2.0.15",
    "commander": "^14.0.3",
    "front-matter": "^4.0.2",
    "gem-analyzer": "^2.3.1",
    "highlight.js": "^11.12.0",
    "marked": "^10.0.0",
    "tsrs": "^0.18.0-ts7.1.0-dev.20260929",
    "yaml": "^1.10.2"
  },
  "devDependencies": {
    "@codesandbox/sandpack-client": "^2.18.2",
    "@gemjs/config": "^2.1.4"
  },
  "author": "mantou132",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantou132/gem.git",
    "directory": "packages/gem-book"
  },
  "bugs": {
    "url": "https://github.com/mantou132/gem/issues"
  },
  "homepage": "https://github.com/mantou132/gem#readme"
}
