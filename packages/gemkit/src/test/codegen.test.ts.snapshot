exports[`generate: 生成路由和入口文件 1`] = `
// Generated by gemkit, do not edit

import { html } from '@mantou/gem';
import { errorRoute, layoutRoute, pageRoute, setOutlets } from '@mantou/gemkit/internal';
import * as RootLayout from "../src/pages/_layout";

const error = errorRoute({ tag: 'gemkit-page-error', load: () => import("../src/pages/_error") }, (params, error) =>
  html\`<gemkit-page-error .params=\${params} .data=\${error}></gemkit-page-error>\`,
);

setOutlets({
  '': [
    layoutRoute("*", { tag: 'gemkit-layout-root', load: async () => RootLayout }, (props) =>
      html\`<gemkit-layout-root .params=\${props.params} .data=\${props.data}></gemkit-layout-root>\`,
    ),
  ],
  'gemkit-layout-root': [
    pageRoute("/files/new", { tag: 'gemkit-page-files-new', load: () => import("../src/pages/files/new") }, (params, data) =>
      html\`<gemkit-page-files-new .params=\${params} .data=\${data}></gemkit-page-files-new>\`,
    ),
    pageRoute("/files/:name", { tag: 'gemkit-page-files-name', load: () => import("../src/pages/files/[name]") }, (params, data) =>
      html\`<gemkit-page-files-name .params=\${params} .data=\${data}></gemkit-page-files-name>\`,
    ),
    pageRoute("/about", { tag: 'gemkit-page-about', load: () => import("../src/pages/about") }, (params, data) =>
      html\`<gemkit-page-about .params=\${params} .data=\${data}></gemkit-page-about>\`,
    ),
    pageRoute("/files/*", { tag: 'gemkit-page-files-path', load: () => import("../src/pages/files/[...path]") }, (params, data) =>
      html\`<gemkit-page-files-path .params=\${params} .data=\${data}></gemkit-page-files-path>\`,
    ),
    layoutRoute("/blog/*", { tag: 'gemkit-layout-blog', load: () => import("../src/pages/blog/_layout") }, (props) =>
      html\`<gemkit-layout-blog .params=\${props.params} .data=\${props.data}></gemkit-layout-blog>\`,
    ),
    pageRoute("/:id", { tag: 'gemkit-page-id', load: () => import("../src/pages/[id]") }, (params, data) =>
      html\`<gemkit-page-id .params=\${params} .data=\${data}></gemkit-page-id>\`,
    ),
    pageRoute("/", { tag: 'gemkit-page-index', load: () => import("../src/pages/index") }, (params, data) =>
      html\`<gemkit-page-index .params=\${params} .data=\${data}></gemkit-page-index>\`,
    ),
    error,
  ],
  'gemkit-layout-blog': [
    pageRoute("/blog/new", { tag: 'gemkit-page-blog-new', load: () => import("../src/pages/blog/new") }, (params, data) =>
      html\`<gemkit-page-blog-new .params=\${params} .data=\${data}></gemkit-page-blog-new>\`,
    ),
    pageRoute("/blog/:slug", { tag: 'gemkit-page-blog-slug', load: () => import("../src/pages/blog/[slug]"), server: true }, (params, data) =>
      html\`<gemkit-page-blog-slug .params=\${params} .data=\${data}></gemkit-page-blog-slug>\`,
    ),
    pageRoute("/blog", { tag: 'gemkit-page-blog-index', load: () => import("../src/pages/blog/index") }, (params, data) =>
      html\`<gemkit-page-blog-index .params=\${params} .data=\${data}></gemkit-page-blog-index>\`,
    ),
    error,
  ],
}, error);

export const app = html\`<gemkit-outlet></gemkit-outlet>\`;

`;

exports[`generate: 生成路由和入口文件 2`] = `
// Generated by gemkit, do not edit

import { createApi, type EndpointMethods } from '@mantou/gemkit/internal';
import type * as endpoint0 from "../src/pages/api/likes/top.server";
import type * as endpoint1 from "../src/pages/api/likes/[slug].server";
import type * as endpoint2 from "../src/pages/api/index.server";
import type * as endpoint3 from "../src/pages/rss.xml.server";

/** 按路径调用 API 路由，例如 \`apis.api.likes(slug).POST({ count: 1 })\` 请求 \`POST /api/likes/<slug>\` */
export const apis: {
  "api": EndpointMethods<typeof endpoint2> & {
    "likes": {
      "top": EndpointMethods<typeof endpoint0>;
      (slug: string): EndpointMethods<typeof endpoint1>;
    };
  };
  "rss.xml": EndpointMethods<typeof endpoint3>;
} = createApi();

`;
