{
  "name": "@mantou/gemkit",
  "version": "0.2.0",
  "description": "Gem application framework: file-based routing, layouts, i18n, SSR and SSG",
  "keywords": [
    "gem",
    "ssr",
    "ssg",
    "framework",
    "rsbuild"
  ],
  "type": "module",
  "bin": {
    "gemkit": "bin/gemkit.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./internal": "./src/internal.ts",
    "./server": "./src/server.ts",
    "./handler": "./src/handler.ts",
    "./adapters/*": "./src/adapters/*/runtime.ts",
    "./init": "./bin/init.js",
    "./plugin": {
      "types": "./src/plugin/index.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "/bin/",
    "/dist/",
    "/src/",
    "/starter/",
    "/template.html"
  ],
  "scripts": {
    "build": "mkdir -p dist && cp -R src/plugin/templates dist/ && esbuild plugin=src/plugin/index.ts serve=src/plugin/serve.ts --outdir=dist --bundle --platform=node --format=esm --packages=external",
    "start": "pnpm build --watch",
    "docs": "gem-book docs",
    "build:docs": "gem-book build docs",
    "test": "tsx --test 'src/**/*.test.ts'",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@mantou/gem": "^2.3.1",
    "@mantou/gem-ssr": "^0.1.1",
    "commander": "^14.0.3",
    "eta": "^4.6.0",
    "hono": "^4.7.4",
    "unplugin-gem": "^0.3.0"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0"
  },
  "devDependencies": {
    "@gemjs/config": "^2.1.4",
    "@rsbuild/core": "^2.0.15",
    "esbuild": "^0.24.0",
    "tsx": "^4.20.6"
  },
  "author": "mantou132",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantou132/gem.git",
    "directory": "packages/gemkit"
  },
  "bugs": {
    "url": "https://github.com/mantou132/gem/issues"
  },
  "homepage": "https://github.com/mantou132/gem#readme"
}
