// Generated by gemkit, do not edit

<% if (it.kind === 'endpoint') { -%>
import type { RequestHandler, ServerLoadContext } from '@mantou/gemkit';
<% } else { -%>
import type { <%= it.server ? 'Jsonify, ' : '' %>ServerLoadContext } from '@mantou/gemkit';
<% } -%>

/** <%= { layout: '布局', page: `页面 \`${it.pattern}\` `, endpoint: `API 路由 \`${it.pattern}\` ` }[it.kind] %>的参数，来自文件路径<%= it.kind === 'layout' ? '，不包括子路由的部分' : '' %> */
export type Params = {<%= it.params.length ? ` ${it.params.map((name) => `${JSON.stringify(name)}: string`).join('; ')} ` : '' %>};

/** `load`、`actions` 和 API 路由处理函数的参数 */
export type ServerContext = ServerLoadContext<Params>;
<% if (it.kind === 'endpoint') { -%>

/** 处理函数，`export const GET = ((ctx) => ...) satisfies Handler`，`ctx` 的类型由它推导，返回值的类型不变 */
export type Handler = RequestHandler<Params>;
<% } else { -%>

/** 服务端模块的 `load`，`export const load = (({ params }) => ...) satisfies Load` */
export type Load = (ctx: ServerContext) => unknown;

/** 服务端模块的 `actions`，`export const actions = { ... } satisfies Actions`，每个 action 的结果类型不变 */
export type Actions = Record<string, (ctx: ServerContext) => unknown>;

/**
 * 服务端 `load` 的结果转换成 JSON 后的类型，是<%= it.kind === 'layout' ? '布局' : '页面' %>的 `data`，
 * <%= it.kind === 'layout' ? '布局' : '页面' %>有 `load` 时是它的 `data` 参数；没有服务端模块或者 `load` 时是 `undefined`
 */
<% if (it.server) { -%>
export type ServerData = typeof import(<%= it.server %>) extends { load: (...args: any) => infer R } ? Jsonify<Awaited<R>> : undefined;
<% } else { -%>
export type ServerData = undefined;
<% } -%>
<% } -%>
<% if (it.kind === 'page') { -%>

/** 动态路由预渲染的参数列表，`export const paths = (() => ...) satisfies Paths` */
export type Paths = (ctx: { lang: string }) => Params[] | Promise<Params[]>;
<% } -%>
