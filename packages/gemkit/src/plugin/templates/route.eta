<% const load = it.path ? `() => import(/* webpackChunkName: "${it.tag}" */ ${it.path})` : 'async () => RootLayout' -%>
<% const flags = `${it.server ? ', server: true' : ''}${it.noLoad ? ', noLoad: true' : ''}${it.ssr === false ? ', ssr: false' : ''}` -%>
<% const info = `{ tag: '${it.tag}', load: ${load}${flags} }` -%>
<% if (it.isError) { -%>
errorRoute(<%= info %>, (params, error) =>
  html`<<%= it.tag %> .params=${params} .data=${error}></<%= it.tag %>>`,
)
<% } else if (it.layout) { -%>
layoutRoute(<%= JSON.stringify(it.pattern) %>, <%= info %>, (props) =>
  html`<<%= it.tag %> .params=${props.params} .data=${props.data}></<%= it.tag %>>`,
)
<% } else { -%>
pageRoute(<%= JSON.stringify(it.pattern) %>, <%= info %>, (params, data) =>
  html`<<%= it.tag %> .params=${params} .data=${data}></<%= it.tag %>>`,
)
<% } -%>
