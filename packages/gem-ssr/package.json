{
  "name": "@mantou/gem-ssr",
  "version": "0.0.15",
  "description": "Server-side rendering and hydration for Gem elements",
  "keywords": [
    "gem",
    "ssr",
    "hydration",
    "web-components"
  ],
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./decorators": "./src/decorators.ts"
  },
  "scripts": {
    "test": "tsx --test",
    "test:watch": "nodemon --watch src -e .ts --exec \"pnpm run test\"",
    "example": "tsx src/example",
    "example:watch": "nodemon --watch src -e .ts --exec \"pnpm run example\""
  },
  "dependencies": {
    "@mantou/gem": "^2.2.14",
    "jsdom": "^26.0.0"
  },
  "devDependencies": {
    "@gemjs/config": "^2.1.3",
    "@hono/node-server": "^1.13.8",
    "@types/jsdom": "^21.1.7",
    "esbuild": "^0.24.0",
    "hono": "^4.7.4",
    "nodemon": "^2.0.7",
    "tsx": "^4.19.3"
  },
  "author": "mantou132",
