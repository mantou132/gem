// Generated by gemkit, do not edit

import { createRenderer } from '@mantou/gemkit/server';
import { defaultLanguage, i18n, languages } from './i18n';
<% if (it.app) { -%>
import <%= it.app %>;
<% } -%>
import { app } from './routes';

const pages = [
<% for (const { pattern, tag, path } of it.pages) { -%>
  { pattern: <%= JSON.stringify(pattern) %>, tag: '<%= tag %>', load: () => import(<%= path %>) },
<% } -%>
];

const layouts = [
<% for (const { pattern, tag, path } of it.layouts) { -%>
  { pattern: <%= JSON.stringify(pattern) %>, tag: '<%= tag %>', load: () => import(<%= path %>) },
<% } -%>
];

const serverModules = {
<% for (const { tag, path } of it.serverModules) { -%>
  '<%= tag %>': () => import(<%= path %>),
<% } -%>
};

export default createRenderer({
  app,
  pages,
  layouts,
  serverModules,
  i18n,
  languages,
  defaultLanguage,
  ...<%= JSON.stringify(it.titleOptions) %>,
});
