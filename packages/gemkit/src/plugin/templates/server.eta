// Generated by gemkit, do not edit

import { createRenderer } from '@mantou/gemkit/server';
import { defaultLanguage, i18n, languages, prefixDefaultLanguage } from './i18n';
<% if (it.app) { -%>
import <%= it.app %>;
<% } -%>
import { app } from './routes';
<% if (it.appServer) { -%>
import * as appServerModule from <%= it.appServer %>;
<% } -%>

const serverModules = {
<% for (const { tag, path } of it.serverModules) { -%>
  '<%= tag %>': () => import(<%= path %>),
<% } -%>
};

const endpoints = [
<% for (const { pattern, path } of it.endpoints) { -%>
  { pattern: '<%= pattern %>', load: () => import(<%= path %>) },
<% } -%>
];

export default createRenderer({
  app,
  serverModules,
  endpoints,
<% if (it.appServer) { -%>
  appServerModule,
<% } -%>
  i18n,
  languages,
  defaultLanguage,
  prefixDefaultLanguage,
  ...<%= JSON.stringify(it.titleOptions) %>,
});
